[Unit]
Description=Poller de monitoreo de red ISP (conexiones SSH persistentes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/monitoreo/src
Environment=MONITOREO_CONFIG=/opt/monitoreo/config.yaml
ExecStart=/opt/monitoreo/venv/bin/python3 /opt/monitoreo/src/poller_daemon.py
Restart=always
RestartSec=5
User=monitoreo-svc
Group=monitoreo-svc

[Install]
WantedBy=multi-user.target
